---
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/ruta.js';

const logos = ['Nordvia', 'Talleres Bruma', 'Kaptur', 'Grupo Aleda', 'Onda Verde', 'Petra Logistics'];

const barras = [42, 58, 51, 73, 66, 88, 79, 96];

const pasos = [
  {
    titulo: 'Diagnostico',
    texto: 'Una sesion de 90 minutos para mapear procesos, fuentes y quien decide que.',
  },
  {
    titulo: 'Conexion',
    texto: 'Enchufamos tus sistemas. Si algo no tiene API, lo resolvemos con carga programada.',
  },
  {
    titulo: 'Modelado',
    texto: 'Definimos indicadores con tu equipo y los dejamos documentados en lenguaje claro.',
  },
  {
    titulo: 'Adopcion',
    texto: 'Formacion, plantillas y acompanamiento durante los dos primeros cierres de mes.',
  },
];

const metricas = [
  { valor: '14 dias', etiqueta: 'Puesta en marcha media' },
  { valor: '120+', etiqueta: 'Equipos ficticios activos' },
  { valor: '6 h', etiqueta: 'Ahorradas por persona y semana' },
  { valor: '99,95 %', etiqueta: 'Disponibilidad del servicio' },
];
---

<Base
  titulo="Cauce — Analitica operativa para equipos que deciden a diario"
  descripcion="Cauce conecta tus fuentes de datos y entrega metricas de operacion listas para usar. Sitio de demostracion con contenido ficticio."
>
  <section class="hero">
    <div class="contenedor hero__interior">
      <div class="hero__texto" data-revelar>
        <p class="antetitulo">Plataforma de analitica operativa</p>
        <h1>Tus datos dejan de vivir en hojas de calculo.</h1>
        <p class="entradilla">
          Cauce conecta tus sistemas, normaliza los eventos y entrega paneles que tu equipo
          entiende sin necesitar a nadie de ingenieria. Puesta en marcha en dos semanas.
        </p>
        <div class="hero__acciones">
          <a class="boton boton--primario" href={ruta('/contacto')}>Pedir una demo</a>
          <a class="boton boton--fantasma" href={ruta('/precios')}>Ver precios</a>
        </div>
        <p class="hero__nota">Sin tarjeta. Prueba de 14 dias con tus propios datos.</p>
      </div>

      <div class="hero__visual" data-revelar aria-hidden="true">
        <div class="panel">
          <div class="panel__barra">
            <span></span><span></span><span></span>
            <p class="panel__titulo">Operaciones · ultimos 30 dias</p>
          </div>
          <div class="panel__cuerpo">
            <div class="panel__kpis">
              <div>
                <span class="panel__kpi">98,4 %</span>
                <span class="panel__kpi-etiqueta">Entregas a tiempo</span>
              </div>
              <div>
                <span class="panel__kpi">1,9 h</span>
                <span class="panel__kpi-etiqueta">Tiempo de ciclo</span>
              </div>
              <div>
                <span class="panel__kpi">-32 %</span>
                <span class="panel__kpi-etiqueta">Incidencias</span>
              </div>
            </div>
            <div class="grafico">
              {barras.map((altura, indice) => (
                <div
                  class:list={['grafico__barra', indice === barras.length - 1 && 'grafico__barra--activa']}
                  style={`--altura: ${altura}%`}
                />
              ))}
            </div>
            <div class="grafico__pie">
              <span>Sem 1</span><span>Sem 4</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="franja" id="confianza">
    <div class="contenedor">
      <p class="franja__titulo">Equipos ficticios que ya lo usan en esta demo</p>
      <ul class="franja__logos">
        {logos.map((logo) => <li>{logo}</li>)}
      </ul>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <header class="seccion__cabecera" data-revelar>
        <p class="antetitulo">Por que Cauce</p>
        <h2>Tres problemas que resolvemos el primer mes</h2>
        <p class="entradilla">
          No vendemos un lienzo en blanco. Llegamos con los indicadores del sector ya
          modelados y los ajustamos a como trabaja tu equipo.
        </p>
      </header>

      <div class="rejilla rejilla--3">
        <article class="tarjeta" data-revelar>
          <div class="tarjeta__icono">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h9" />
            </svg>
          </div>
          <h3>Una sola fuente de verdad</h3>
          <p>
            Conectores para ERP, CRM, almacen y hojas de calculo. Los datos se unifican con
            el mismo criterio, asi que ventas y operaciones dejan de discutir sobre las cifras.
          </p>
        </article>

        <article class="tarjeta" data-revelar>
          <div class="tarjeta__icono">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v4M12 17v4M3 12h4M17 12h4" />
              <circle cx="12" cy="12" r="3.5" />
            </svg>
          </div>
          <h3>Alertas que llegan a tiempo</h3>
          <p>
            Umbrales por proceso y aviso en Slack o correo cuando algo se desvia. El turno de
            noche se entera del problema sin esperar al informe de la manana.
          </p>
        </article>

        <article class="tarjeta" data-revelar>
          <div class="tarjeta__icono">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 19V9M10 19V5M16 19v-6M22 19H2" />
            </svg>
          </div>
          <h3>Informes sin trabajo manual</h3>
          <p>
            El comite recibe el mismo panel cada lunes, generado solo. Se acabo el becario
            copiando celdas entre siete ficheros distintos.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="seccion seccion--alterna">
    <div class="contenedor">
      <header class="seccion__cabecera" data-revelar>
        <p class="antetitulo">Como funciona</p>
        <h2>De la primera llamada al primer panel</h2>
      </header>

      <ol class="pasos">
        {pasos.map((paso, indice) => (
          <li class="paso" data-revelar>
            <span class="paso__numero">{indice + 1}</span>
            <h3>{paso.titulo}</h3>
            <p>{paso.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="metricas">
        {metricas.map((metrica) => (
          <div class="metrica" data-revelar>
            <span class="metrica__valor">{metrica.valor}</span>
            <span class="metrica__etiqueta">{metrica.etiqueta}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--alterna">
    <div class="contenedor contenedor--estrecho">
      <figure class="cita" data-revelar>
        <blockquote>
          Llevabamos dos anos intentando montar esto por dentro. Con Cauce tuvimos el primer
          panel util en once dias y, sobre todo, dejamos de discutir de donde salia cada numero.
        </blockquote>
        <figcaption>
          <span class="cita__avatar" aria-hidden="true">MR</span>
          <span>
            <strong>Marta Rivas</strong>
            Directora de operaciones, Nordvia
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="cta">
    <div class="contenedor cta__interior" data-revelar>
      <div>
        <h2>Vemos tus datos en una llamada de 30 minutos</h2>
        <p>Sin presentacion generica: trabajamos sobre un proceso real tuyo.</p>
      </div>
      <a class="boton boton--claro" href={ruta('/contacto')}>Reservar una demo</a>
    </div>
  </section>
</Base>
