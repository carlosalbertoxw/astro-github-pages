---
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/ruta.js';
---

<Base
  titulo="Página no encontrada — Cauce"
  descripcion="La página solicitada no existe."
  noindex
>
  <section class="portada portada--centrada">
    <div class="contenedor contenedor--estrecho">
      <p class="antetitulo">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="entradilla">
        El enlace puede estar mal escrito o el contenido haberse movido. GitHub Pages sirve
        este archivo automáticamente para cualquier ruta desconocida.
      </p>
      <div class="hero__acciones">
        <a class="boton boton--primario" href={ruta('/')}>Volver al inicio</a>
        <a class="boton boton--fantasma" href={ruta('/contacto')}>Contactar</a>
      </div>
    </div>
  </section>
</Base>
