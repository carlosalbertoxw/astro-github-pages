---
import Marca from './Marca.astro';
import { ruta } from '../lib/ruta.js';

// Año del despliegue como valor inicial; src/scripts/anio.js lo actualiza en el
// navegador para que no se quede congelado hasta el siguiente build.
const anio = new Date().getFullYear();

const columnas = [
  {
    titulo: 'Producto',
    enlaces: [
      { href: '/servicios', texto: 'Servicios' },
      { href: '/precios', texto: 'Precios' },
      { href: '/casos', texto: 'Casos de éxito' },
      { href: '/servicios#integraciones', texto: 'Integraciones' },
    ],
  },
  {
    titulo: 'Compañía',
    enlaces: [
      { href: '/#confianza', texto: 'Clientes' },
      { href: '/contacto', texto: 'Contacto' },
      { href: '/contacto#faq', texto: 'Preguntas frecuentes' },
    ],
  },
];
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie__rejilla">
      <div class="pie__marca">
        <Marca />
        <p class="pie__lema">
          Analítica operativa para equipos que toman decisiones cada día, no cada trimestre.
        </p>
      </div>

      {columnas.map((columna) => (
        <div>
          <h3 class="pie__titulo">{columna.titulo}</h3>
          <ul class="pie__lista">
            {columna.enlaces.map((enlace) => (
              <li><a href={ruta(enlace.href)}>{enlace.texto}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="pie__titulo">Contacto</h3>
        <ul class="pie__lista">
          <li><a href="mailto:hola@cauce.example">hola@cauce.example</a></li>
          <li><a href="tel:+34900000000">+34 900 000 000</a></li>
          <li>Calle Ejemplo 000, Madrid</li>
        </ul>
      </div>
    </div>

    <div class="pie__legal">
      <p>&copy; <span data-anio>{anio}</span> Cauce. Empresa ficticia, contenido de relleno para una demo.</p>
      <p>Hecho con Astro y publicado en GitHub Pages.</p>
    </div>
  </div>
</footer>
