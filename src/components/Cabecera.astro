---
import Marca from './Marca.astro';
import { ruta, esActual } from '../lib/ruta.js';

const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/servicios', texto: 'Servicios' },
  { href: '/precios', texto: 'Precios' },
  { href: '/casos', texto: 'Casos' },
  { href: '/contacto', texto: 'Contacto' },
];

const actual = Astro.url.pathname;
---

<a class="skip-link" href="#contenido">Saltar al contenido</a>

<header class="cabecera">
  <div class="contenedor cabecera__interior">
    <Marca />

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-principal"
    >
      <span class="visualmente-oculto">Abrir menú</span>
      <span class="nav-toggle__icono" aria-hidden="true"></span>
    </button>

    <nav class="nav" id="nav-principal" aria-label="Navegación principal">
      <ul class="nav__lista">
        {enlaces.map((enlace) => (
          <li>
            <a
              href={ruta(enlace.href)}
              aria-current={esActual(actual, enlace.href) ? 'page' : undefined}
            >
              {enlace.texto}
            </a>
          </li>
        ))}
      </ul>
      <a class="boton boton--primario boton--sm" href={ruta('/contacto')}>Pedir una demo</a>
    </nav>
  </div>
</header>
